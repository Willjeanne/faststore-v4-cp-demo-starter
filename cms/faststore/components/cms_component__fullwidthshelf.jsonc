{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "FullWidthShelf",
  "$componentTitle": "Full Width Shelf",
  "title": "Full Width Shelf",
  "description": "Full-width product carousel fetched from VTEX catalog by category ID",
  "type": "object",
  "required": ["categorySlug"],
  "properties": {
    "title": { "title": "Section title (optional)", "type": "string", "default": "" },
    "categorySlug": {
      "title": "Category Name",
      "description": "Exact category name from VTEX Admin (e.g. Soccer, Basketball, Training) — case-insensitive",
      "type": "string",
      "default": ""
    },
    "count": {
      "title": "Number of products to display",
      "type": "integer",
      "enumNames": ["4 products","8 products","12 products"],
      "enum": [4, 8, 12],
      "default": 8
    }
  }
}
