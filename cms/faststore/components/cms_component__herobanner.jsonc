{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "HeroBanner",
  "$componentTitle": "Hero Banner",
  "title": "Hero Banner",
  "description": "Full-width hero with image, title, subtitle and CTA",
  "type": "object",
  "required": [],
  "properties": {
    "title": { "title": "Title", "type": "string", "default": "FC Bayern München" },
    "subtitle": { "title": "Subtitle", "type": "string", "default": "" },
    "ctaLabel": { "title": "CTA button text", "type": "string", "default": "Shop Now" },
    "ctaUrl": { "title": "CTA URL", "type": "string", "default": "/" },
    "imageDesktop": {
      "title": "Image (desktop)",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": { "video": true, "image": ["png","jpg","jpeg","gif","svg","webp"] }
      }
    },
    "imageMobile": {
      "title": "Image (mobile, optional)",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": { "video": true, "image": ["png","jpg","jpeg","gif","svg","webp"] }
      }
    },
    "imageAlt": { "title": "Image alt text", "type": "string", "default": "" },
    "textPosition": {
      "title": "Text position",
      "type": "string",
      "enumNames": ["Top left","Top center","Top right","Middle left","Middle center","Middle right","Bottom left","Bottom center","Bottom right"],
      "enum": ["top-left","top-center","top-right","middle-left","middle-center","middle-right","bottom-left","bottom-center","bottom-right"],
      "default": "middle-left"
    },
    "textColor": {
      "title": "Text color",
      "type": "string",
      "enumNames": ["White","Black"],
      "enum": ["white","black"],
      "default": "white"
    },
    "overlayOpacity": {
      "title": "Overlay opacity (0–80)",
      "type": "integer",
      "default": 30
    }
  }
}
