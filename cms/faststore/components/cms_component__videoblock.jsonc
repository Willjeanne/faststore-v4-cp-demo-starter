{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "VideoBlock",
  "$componentTitle": "Video Block",
  "title": "Video Block",
  "description": "Embed a YouTube video or an MP4 file. Pick a video from VTEX Media or paste an external URL.",
  "type": "object",
  "properties": {
    "sectionTitle": {
      "title": "Section title (optional)",
      "type": "string",
      "default": ""
    },
    "videoUrl": {
      "title": "Video (from VTEX Media)",
      "description": "Pick a video from the media library. Videos in VTEX are referenced by URL (typically YouTube).",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery"
      }
    },
    "videoUrlExternal": {
      "title": "Or external video URL",
      "description": "Alternative — paste a YouTube URL (youtube.com/watch?v=... or youtu.be/...) or a direct .mp4/.webm/.mov file URL",
      "type": "string",
      "default": ""
    },
    "posterImage": {
      "title": "Poster image (optional)",
      "description": "Preview image shown before the video plays. Click triggers playback.",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": {
          "video": true,
          "image": ["png", "jpg", "jpeg", "gif", "svg", "webp"]
        }
      }
    },
    "posterAlt": {
      "title": "Poster image alt text",
      "type": "string",
      "default": ""
    },
    "aspectRatio": {
      "title": "Aspect ratio",
      "description": "16:9 (default) / 4:3 / 1:1 (square) / 9:16 (vertical, mobile-style)",
      "type": "string",
      "default": "16:9"
    },
    "autoplay": {
      "title": "Autoplay",
      "description": "Auto-start playback (videos will be muted, browser policy)",
      "type": "boolean",
      "default": false
    },
    "loop": {
      "title": "Loop",
      "description": "Replay automatically when the video ends",
      "type": "boolean",
      "default": false
    },
    "controls": {
      "title": "Show player controls",
      "type": "boolean",
      "default": true
    },
    "fullWidth": {
      "title": "Full-width (edge to edge)",
      "description": "If enabled, the video spans the entire screen width with no padding",
      "type": "boolean",
      "default": false
    }
  }
}
